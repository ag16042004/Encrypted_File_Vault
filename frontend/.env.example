# ---------------------------------------------------------------------------
# Copy this file to  frontend/.env  and edit.   (Restart `npm run dev` after changes.)
# ---------------------------------------------------------------------------

# Which blockchain the app talks to.
#   31337     = local Hardhat node (npm run node + npm run deploy:local)
#   11155111  = Ethereum Sepolia test network (npm run deploy:sepolia)
VITE_CHAIN_ID=31337

# Optional: override the contract address (normally read from src/contracts/deployments.json)
# VITE_CONTRACT_ADDRESS=0x...

# Where encrypted files are stored.
#   local   = built-in IPFS simulator that keeps the encrypted blobs in this browser (demo, no account needed)
#   pinata  = real IPFS through Pinata (needs VITE_PINATA_JWT)
VITE_STORAGE_MODE=local

# Pinata API key (JWT). Create one at https://app.pinata.cloud/developers/api-keys
# with ONLY the "pinFileToIPFS" permission. It is visible in the browser bundle,
# so never use a key with wider permissions.
# VITE_PINATA_JWT=eyJhbGciOi...

# Gateway used to download from IPFS (use your own Pinata gateway for best results)
# VITE_IPFS_GATEWAY=https://your-name.mypinata.cloud

# Largest file accepted, in MB, and the storage capacity shown on the dashboard, in GB.
VITE_MAX_FILE_MB=200
VITE_STORAGE_CAPACITY_GB=50
